@page
@model WebEditor.IndexModel
@{
    ViewData["Title"] = "Web Editor";
}

<html>
    <head>
        <title>@ViewData["Title"]</title>
        <script type="text/javascript" src="js/index.js"></script>
    </head>
    <body>
        <div style="padding: 12px; display: flex; align-items: center; gap: 10px;">
            <label for="downloadType" style="font-weight: 600;">Download as:</label>
            <select id="downloadType" style="padding: 4px;">
                <option value="pdf">PDF</option>
                <option value="txt">Text</option>
            </select>

            <button onclick="startDownload()">Download</button>
        </div>

        <textarea id="editedarea" style="width: 90%; height: 90%"></textarea>
    </body>
</html>
